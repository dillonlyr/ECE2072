module register_tb;

    // I/O variables:
	reg [15:0] in;
	wire [15:0] out;
	reg enable, clk, rst;
	
	// Instantiate the module:
	register test1(.r_in(in), .enable(enable), .clk(clk), .Q(out), .rst(rst));
	
	initial begin
		// assign 0 to all inputs
		in <= 0
		enable <= 0;
		clk <= 0;
		rst <= 0;
	end
	
	always begin
		#10
		in = in + 1;
	end
	
	// create and initialize your testbench statistics
	integer count, errors;
	
	initial begin
		// assign 0 to all variables
		count = 0;
		errors = 0;
	end
	
	always begin
		#9
		if (count == 512) begin
			#10 /* Display that the code is finished, and state how many errors occured*/;
			$display("Done with sign_extend test with test count %0d.", count);
			$display("There were %0d errors.", errors);
			// Stop the test bench
			$stop;
		end
		
		if (in[8] != out[15] || in[8] != out[14] || in[8] != out[13] || in[8] != out[12] || in[8] != out[11] || in[8] != out[11] ||
		in[8] != out[10] || in[8] != out[9])
		    errors = errors + 1;
		
		#1
		// increment the test case count
		count = count + 1;
	end
    

endmodule